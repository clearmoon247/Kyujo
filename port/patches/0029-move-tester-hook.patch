+/* PORT (patch 0029): the move tester (host_movetest.c). Memmap_SetFragmentMap runs when a code overlay has just been loaded; for the battle engine
+ * that is after the two teams have been built and before the battle reads them. The host (the "Move animation test" page of the menu) may ask for
+ * the first player's lead Pokemon to be another species that knows only one chosen move, and for the opponent's lead to be another species, so that
+ * any move can be watched on any Pokemon. Offsets as in game_state.h: BattleMon 0x00 species, 0x09..0x0C moves, 0x20..0x23 PP. */
+#define PORT_BATTLE_ENGINE_FRAGMENT_ID 51 /* FRAGMENT_ID(FRAGMENT_BATTLE_ENGINE): ((0x84300000 & 0x0FF00000) >> 20) - 0x10 */
+extern int __osHostMoveTestValue(int which);   /* 0: tester armed (1/0), 1: player species, 2: player move, 3: opponent species (0 = unchanged) */
+extern void __osHostMoveTestNotice(int applied);
+
+static void Port_ApplyMoveTestToMon(BattleMon* mon, int species, int move) {
+    if (mon == NULL) {
+        return;
+    }
+    if (species != 0) {
+        mon->unk_00.unk_00 = species;
+    }
+    if (move != 0) {
+        mon->unk_09[0] = move;
+        mon->unk_09[1] = 0;
+        mon->unk_09[2] = 0;
+        mon->unk_09[3] = 0;
+        mon->unk_20[0] = 40; /* enough PP for any test */
+        mon->unk_20[1] = 0;
+        mon->unk_20[2] = 0;
+        mon->unk_20[3] = 0;
+    }
+}
+
+static void Port_ApplyMoveTest(void) {
+    s32 side;
+    int species;
+    int move;
+
+    if (__osHostMoveTestValue(0) == 0) {
+        return;
+    }
+    for (side = 0; side < 2; side++) {
+        TeamRoster* roster = gSessionContext.battleSides[side].teamMember[0];
+        if (roster == NULL) {
+            continue;
+        }
+        species = __osHostMoveTestValue(side == 0 ? 1 : 3);
+        move = side == 0 ? __osHostMoveTestValue(2) : 0;
+        Port_ApplyMoveTestToMon(&roster->pokemonPicked[0], species, move); /* the lead: the first Pokemon picked */
+        if (roster->rosterInfo != NULL) {
+            Port_ApplyMoveTestToMon(&roster->rosterInfo->unk_028[0], species, move); /* the roster's own copy */
+        }
+    }
+    __osHostMoveTestNotice(1);
+}
+
=3
+    if (id == PORT_BATTLE_ENGINE_FRAGMENT_ID) { /* PORT (patch 0029) */
+        Port_ApplyMoveTest();
+    }
=3
