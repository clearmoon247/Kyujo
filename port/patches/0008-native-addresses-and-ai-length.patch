+++ b/src/3D140.c
@@ -362,7 sha256=963988b23367c2c01c7511016937fed9d7f8bf6e38f95e65c4fa1a3d77211766 @@
=3
-1
+    samplesLeft = IO_READ(AI_LEN_REG) >> 2; // PORT: the audio interface is emulated (src/ultra/hw_ai.c)
=3
