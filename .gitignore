# Tooling noise
__pycache__/
*.pyc
.venv/
.vscode/
.idea/

# Built programs and packages: they contain compiled decomp code and must never be committed or attached to a release (NOTICE.md)
*.exe
*.dll
*.apk
*.aab
*.AppImage
*.wasm
*.so
*.zip
*.bundle
*.keystore
*.jks

# Secrets
.env
*.pem
